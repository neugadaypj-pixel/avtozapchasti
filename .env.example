# MongoDB Atlas — основная база данных.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=zapchast

# Cloudflare R2 (S3-совместимое объектное хранилище для фото).
# Если не заполнены — фото сохраняются локально в server/data/uploads/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zapchast-photos
R2_PUBLIC_URL=

# Секрет для JWT-токенов (в продакшене обязательно задать свой).
JWT_SECRET=

# Порт сервера (по умолчанию 4000).
PORT=4000
