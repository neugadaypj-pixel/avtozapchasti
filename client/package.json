{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AvtoZapchasti — приложение для магазина запчастей",
  "author": "AvtoZapchasti",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "vite build --mode native",
    "electron": "electron .",
    "electron:build": "vite build --mode native && electron-builder",
    "capacitor:sync": "npx cap sync",
    "capacitor:add:android": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "uz.avtozapchasti.desktop",
    "productName": "AvtoZapchasti",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
